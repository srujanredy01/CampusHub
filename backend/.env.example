# ═══════════════════════════════════════════════════════════════════════════════
# CampusHub — Environment Configuration
# Copy this file to .env and fill in your values.
# For production: cp .env.production .env && nano .env
# ═══════════════════════════════════════════════════════════════════════════════

# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend

# ── Database ──────────────────────────────────────────────────────────────────
DB_NAME=campushub
DB_USER=campushub_user
DB_PASSWORD=campushub_pass
DB_HOST=db
DB_PORT=5432

# ── AWS S3 (set USE_S3=True to enable cloud storage) ─────────────────────────
USE_S3=False
AWS_ACCESS_KEY_ID=your-key
AWS_SECRET_ACCESS_KEY=your-secret
AWS_STORAGE_BUCKET_NAME=campushub-files
AWS_S3_REGION_NAME=us-east-1

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@campushub.com

# ── Frontend URL ──────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost

# ── Code Executor Service ─────────────────────────────────────────────────────
EXECUTOR_SERVICE_URL=http://executor:8001
EXECUTOR_TIMEOUT=10

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
CORS_ALLOW_ALL_ORIGINS=False

# ── CSRF (required for Django admin behind proxy) ─────────────────────────────
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# ── Logging ───────────────────────────────────────────────────────────────────
DJANGO_LOG_LEVEL=INFO

# ── Admin Account (created on first startup) ──────────────────────────────────
ADMIN_EMAIL=admin@campushub.com
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=CampusHub Admin
ADMIN_STUDENT_ID=0000000

# ── Monitoring (only needed with docker-compose.monitoring.yml) ───────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_grafana_pass
