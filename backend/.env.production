# ── CampusHub Production Environment ─────────────────────────────────────────
# COPY this file to .env on your EC2 instance and fill in all values.
# NEVER commit this file with real secrets to git.
#
# Usage on EC2:
#   cp backend/.env.production backend/.env
#   nano backend/.env  # fill in real values
#   docker compose -f docker-compose.prod.yml up -d --build

# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_use_python_secrets_token_hex_50
DEBUG=False
ALLOWED_HOSTS=YOUR_EC2_ELASTIC_IP,YOUR_DOMAIN.com,www.YOUR_DOMAIN.com,backend

# ── Database ──────────────────────────────────────────────────────────────────
DB_NAME=campushub
DB_USER=campushub_user
DB_PASSWORD=CHANGE_ME_strong_db_password
DB_HOST=db
DB_PORT=5432

# ── AWS S3 (set USE_S3=True to enable cloud storage for uploads) ─────────────
USE_S3=True
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY
AWS_STORAGE_BUCKET_NAME=campushub-files
AWS_S3_REGION_NAME=ap-south-1

# ── Email (use real SMTP in production) ───────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=noreply@campushub.com

# ── URLs ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://YOUR_EC2_ELASTIC_IP
EXECUTOR_SERVICE_URL=http://executor:8001
EXECUTOR_TIMEOUT=10

# ── Redis & Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/3

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://YOUR_EC2_ELASTIC_IP,https://YOUR_DOMAIN.com
CORS_ALLOW_ALL_ORIGINS=False

# ── CSRF (required for Django admin behind proxy) ─────────────────────────────
CSRF_TRUSTED_ORIGINS=http://YOUR_EC2_ELASTIC_IP,https://YOUR_DOMAIN.com

# ── Logging ───────────────────────────────────────────────────────────────────
DJANGO_LOG_LEVEL=WARNING

# ── Admin Account (created on first startup) ──────────────────────────────────
ADMIN_EMAIL=admin@campushub.com
ADMIN_PASSWORD=CHANGE_ME_strong_admin_password
ADMIN_NAME=CampusHub Admin
ADMIN_STUDENT_ID=0000000

# ── Monitoring (only needed if using docker-compose.monitoring.yml) ────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_strong_grafana_password
